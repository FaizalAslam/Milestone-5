{
  "name": "Groww \u2014 append_product_update",
  "nodes": [
    {
      "id": "workflow-input",
      "name": "Workflow input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
